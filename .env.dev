# .env
APP_NAME=GoldTrack Vietnam
APP_VERSION=1.0.0

# API URLs
# Development (local)
API_BASE_URL_DEV=localhost:8001/api/v1
# Production (Render)
API_BASE_URL_PROD=https://be-gold-track-vn.onrender.com/api/v1

API_BASE_URL_LOCAL=localhost:8001/api/v1


# Current environment (dev/prod)
APP_ENV=dev

# Timeout
API_CONNECT_TIMEOUT=30
API_RECEIVE_TIMEOUT=30

# Feature flags
ENABLE_LOCATION_SERVICES=true
ENABLE_PUSH_NOTIFICATIONS=true